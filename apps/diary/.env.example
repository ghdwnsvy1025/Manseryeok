# Supabase (레거시와 같은 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# 서버 전용. 운세 캐시 쓰기 등에만 쓴다 (2단계부터)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 운세 글(3단계). 없으면 템플릿 문장만
ANTHROPIC_API_KEY=
# 운세 글 모델 (기본 claude-sonnet-5)
# FORTUNE_MODEL=claude-sonnet-5
# v4.10 문맥 검수 모델. 적으면 검사를 통과한 글을 편집자 역할 모델이 한 번 더 읽고(비약·끊김·가리킴·어긋남·뻔한말) 걸리면 한 번 고쳐 씀.
# 사용자마다 하루 호출이 1~2회 늘어나므로 싼 모델로. 비우면 검수 없음
# FORTUNE_REVIEW_MODEL=claude-haiku-4-5-20251001
