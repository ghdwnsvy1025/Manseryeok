# Supabase (레거시와 같은 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# 서버 전용. 운세 캐시 쓰기 등에만 쓴다 (2단계부터)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 운세 글(3단계). 없으면 템플릿 문장만
ANTHROPIC_API_KEY=
# 운세 글 모델 (기본 claude-sonnet-5)
# FORTUNE_MODEL=claude-sonnet-5
# v4.10 문맥 검수 모델. 적으면 검사를 통과한 글을 편집자 역할 모델이 한 번 더 읽고(비약·끊김·가리킴·어긋남·뻔한말) 걸리면 한 번 고쳐 씀.
# 사용자마다 하루 호출이 1~2회 늘어나므로 싼 모델로. 비우면 검수 없음
# FORTUNE_REVIEW_MODEL=claude-haiku-4-5-20251001

# 운세 모델 호출 하루 상한(행 수). 넘으면 그날 남은 요청은 템플릿 글. 기본 2000 (전체검토 2026-10-14 B-H1)
# FORTUNE_DAILY_CAP=2000
# 푸시 알림 (설정 → 알림 켜기). 셋 다 있어야 동작한다. 키는 `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel cron(/api/cron/remind)의 Bearer 비밀. 없으면 크론이 401
CRON_SECRET=
# 운영 숫자 화면(/stats?key=) 비밀
STATS_KEY=
# 이용 통계 (PostHog, docs/측정.md). 사주 일기용 프로젝트의 phc_ 키. 비우면 보내지 않는다 (localhost에서는 키가 있어도 console.debug만)
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
